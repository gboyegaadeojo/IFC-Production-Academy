# Copy to .env.local for local development. Placeholder values only: never commit real ones.
# Local values come from `npx supabase status -o env` after `npm run db:start`.

# --- App (public: inlined into the browser bundle at build time) ---------------------------
# The Supabase API URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable (anon) key. Safe to expose because row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Where the app runs. Used to build sign-in links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

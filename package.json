{
  "name": "ifc-production-academy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "help:build": "node scripts/build-help.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:types": "supabase gen types typescript --local > lib/data/database.types.ts && prettier --write lib/data/database.types.ts",
    "push:keys": "node scripts/setup-push-keys.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "next": "16.4.6",
    "posthog-js": "1.454.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "engines": {
    "node": ">=24"
  }
}

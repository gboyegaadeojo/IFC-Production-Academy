{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifc-production-academy",
  // The app plus the live room (ADD-DASH-09). See workers/entry.ts.
  "main": "workers/entry.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by OpenNext for caching; the name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ifc-production-academy",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE_ROOM", "class_name": "LiveRoom" }],
  },
  "migrations": [{ "tag": "live-room-v1", "new_sqlite_classes": ["LiveRoom"] }],
  "observability": {
    "enabled": true,
  },
  // Starts the frequent GitHub jobs on time (workers/entry.ts, docs/runbooks/scheduling.md).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Runtime configuration lives in Cloudflare (dashboard or `wrangler secret put`), never here.
  // NEXT_PUBLIC_* values are inlined at build time, so set them as build variables too (README).
}
